# Copie este ficheiro para `.env` e preencha com a tua chave.
# O ficheiro `.env` NUNCA é commitado (está no .gitignore).
#
# Chave da API da Anthropic: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# (Opcional) Força o modo determinístico (sem LLM), mesmo com chave definida:
# MADO_LLM_PROVIDER=none