│   └── dependencies.py
├── findings/
│   ├── schema.py             # normalização
│   └── cache.py
├── rag/
│   ├── ingest.py              # indexação offline OWASP/CWE
│   ├── retrieval.py
│   └── data/                  # docs fonte (OWASP, CWE)
├── llm/
│   ├── prompts.py
│   └── client.py
├── report/
